# Server Port
PORT=8000

# MongoDB Connection URI (e.g. MongoDB Atlas cluster link)
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/resume_builder?retryWrites=true&w=majority"

# JSON Web Token Secret (used for signing user authentication tokens)
JWT_SECRET="your_jwt_secret_random_string_here"

# Google Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY="AIzaSy..."
